#!/bin/sh
# pretends to be PHP 8.5, and starts a worker that misbehaves while it starts
# in the way that the name of its target file tells
if [ "$1" = "-r" ]; then
    echo "8 5 8.5.0"
    exit 0
fi

behaviour=''

while [ $# -gt 0 ]; do
    if [ "$1" = "--target" ]; then
        behaviour=$(basename "$2")
    fi

    shift
done

# writes a frame whose payload is shorter than 256 bytes
frame() {
    printf "\\000\\000\\000\\$(printf '%03o' "${#1}")%s" "$1"
}

case "$behaviour" in
    other-protocol)
        frame '{"type":"ready","protocol":2}' ;;
    invalid-handshake)
        frame '{"type":"ready","protocol":1,"maximumNumberOfChoices":0}' ;;
    no-name)
        frame '{"type":"ready","protocol":1,"maximumNumberOfChoices":8192}' ;;
    invalid-target-description)
        frame '{"type":"targets","protocol":1,"targets":[{"name":"a","file":"a.php","maximumNumberOfChoices":0}]}' ;;
    no-targets)
        frame '{"type":"targets","protocol":1,"targets":[]}' ;;
    invalid-frame)
        frame '{x' ;;
    exits)
        echo 'the worker cannot start' >&2
        exit 1 ;;
esac

# waits until the supervisor closes the standard input stream
cat > /dev/null
