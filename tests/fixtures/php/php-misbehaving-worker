#!/bin/sh
# pretends to be PHP 8.5, and starts a worker that misbehaves while it starts,
# or after it received the first input, in the way that the name of its target
# file tells
if [ "$1" = "-r" ]; then
    echo "8 5 8.5.0"
    exit 0
fi

behaviour=''

while [ $# -gt 0 ]; do
    if [ "$1" = "--target" ]; then
        behaviour=$(basename "$2")
    fi

    shift
done

# writes a frame whose payload is shorter than 256 bytes
frame() {
    printf "\\000\\000\\000\\$(printf '%03o' "${#1}")%s" "$1"
}

case "$behaviour" in
    other-protocol)
        frame '{"type":"ready","protocol":2}' ;;
    invalid-handshake)
        frame '{"type":"ready","protocol":1,"maximumNumberOfChoices":0}' ;;
    no-name)
        frame '{"type":"ready","protocol":1,"maximumNumberOfChoices":8192}' ;;
    invalid-target-description)
        frame '{"type":"targets","protocol":1,"targets":[{"name":"a","file":"a.php","maximumNumberOfChoices":0}]}' ;;
    no-targets)
        frame '{"type":"targets","protocol":1,"targets":[]}' ;;
    invalid-frame)
        frame '{x' ;;
    exits)
        echo 'the worker cannot start' >&2
        exit 1 ;;
    unexpected-message|unknown-result|last-result-without-exit)
        frame '{"type":"ready","protocol":1,"name":"misbehaving","maximumNumberOfChoices":8192}'

        # waits for the first message of the supervisor, and ends when the
        # supervisor shuts it down
        message=$(head -c 20 | tr -d '\000')

        case "$message" in
            *shutdow*)
                exit 0 ;;
        esac

        case "$behaviour" in
            unexpected-message)
                frame '{"type":"other"}' ;;
            unknown-result)
                frame '{"type":"result","result":{"id":99,"outcome":"passed","features":[]},"retire":false}' ;;
            last-result-without-exit)
                frame '{"type":"result","result":{"id":1,"outcome":"failed","features":[],"failure":{"kind":"exit","message":"","trace":""}},"last":true}'

                # does not end until it is killed
                exec sleep 60 ;;
        esac

        exit 0 ;;
esac

# waits until the supervisor closes the standard input stream
exec cat > /dev/null
