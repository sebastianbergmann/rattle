<?php declare(strict_types=1);
namespace PHPUnit\Runner\PropertyBased;

/**
 * PHPUnit's API for running the examples of properties one at a time, which
 * PHPUnit 14 provides. The development dependency of rattle is an earlier
 * version of PHPUnit, so PHPStan knows the API from this stub. What the API
 * returns is declared as mixed, because rattle checks it like data that it
 * receives from another process.
 */
final class PropertyRunner
{
    /**
     * @param ?non-empty-string $configurationFile
     * @param ?non-empty-string $filter
     */
    public static function boot(?string $configurationFile = null, ?string $filter = null): self
    {
    }

    public function properties(): mixed
    {
    }

    /**
     * @param non-empty-string       $id
     * @param list<non-negative-int> $choices
     * @param positive-int           $timeLimit
     */
    public function replay(string $id, array $choices, int $timeLimit): mixed
    {
    }

    /**
     * @param non-empty-string $id
     * @param positive-int     $timeLimit
     */
    public function generate(string $id, int $seed, int $timeLimit): mixed
    {
    }
}
